# Pinned versions of every tool a gate depends on.
# Read by `chock init --global` (installs these) and `chock doctor` (fails when the machine drifts).
# A newer chock's `chock init` sets every key chock pins, and keeps each key it does not.
# KEY_VERSION pins a crate; KEY_BIN overrides the executable name when it differs from the crate;
# KEY_SETUP runs after installing, for a tool that fetches the rest of itself; KEY_OS lists the
# systems a tool runs on (linux, macos, windows), where that is not all of them.
# KEY_URL and KEY_SHA256 pin a file to download instead of a crate: init fetches it, keeps it only
# when its SHA-256 matches, and unpacks an archive. KEY_URL_linux (or _macos, _x86_64, _arm64…)
# pins one file for each system. A value may use ${KEY} of an earlier line.
# An unpinned gate tool means two machines score the same tree differently and neither is wrong.

# First, so every tool after it installs from its own prebuilt release instead of compiling.
CARGO_BINSTALL_VERSION=1.25.3
CARGO_NEXTEST_VERSION=0.9.148
CARGO_LLVM_COV_VERSION=0.9.1
CARGO_CRAP_VERSION=0.8.0
# cargo-deny from the outpostHQ fork: 0.20.2 overflows its stack on a dependency cycle in
# `check bans` (EmbarkStudios/cargo-deny#910). The fork fixes it; init compiles it from this commit.
CARGO_DENY_VERSION=0.20.2
CARGO_DENY_GIT=https://github.com/outpostHQ/cargo-deny
CARGO_DENY_REV=07d12874999928af53354c0826b517ddc6f2303d
CARGO_SORT_VERSION=2.1.4
CARGO_ACL_VERSION=0.9.0
# cackle refuses to compile anywhere but Linux; elsewhere init skips it and doctor says why.
CARGO_ACL_OS=linux
CARGO_MACHETE_VERSION=0.9.2
# udeps needs a nightly toolchain and a full build, so it is opt-in. It is not a superset of
# machete and machete is not a superset of it, which is why both are pinned.
CARGO_UDEPS_VERSION=0.1.61
CARGO_BSIZE_VERSION=0.0.2
TYPOS_CLI_VERSION=1.51.1
TYPOS_CLI_BIN=typos
# Outpost's fork, on no registry: `chock init --global` builds the newest commit of its `main`, and
# doctor compares the installed commit with that one.
CARGO_MUTEST_VERSION=0.0.0
# mutest-driver links librustc_driver from one exact compiler build, so the binary only runs with
# the nightly it was built against. Installed with rustc-dev and llvm-tools.
MUTEST_NIGHTLY=nightly-2026-10-17
# The crate is kani-verifier; the binary it installs is kani.
KANI_VERIFIER_VERSION=0.68.0
KANI_VERIFIER_BIN=kani
# Kani publishes builds for Linux and macOS only.
KANI_VERIFIER_OS=linux,macos
# Installing the crate gets a shim; the solver bundle and the nightly it runs on arrive on first use.
KANI_VERIFIER_SETUP="cargo kani --version"
# Outpost's CLI, for the gates that ask it something chock does not answer for itself. Not on
# crates.io either, and every gate that uses it is opt-in and says so when it is absent.
OUTPOST_VERSION=0.0.0
# The TLA+ model checker TLC, for the opt-in `tla` gate: the latest release. The 1.8.0 nightly
# is no pin: GitHub replaces its jar each night, and the jar on Maven leaves out what it loads.
TLA_TOOLS_VERSION=1.7.4
TLA_TOOLS_URL=https://github.com/tlaplus/tlaplus/releases/download/v${TLA_TOOLS_VERSION}/tla2tools.jar
TLA_TOOLS_SHA256=936a262061c914694dfd669a543be24573c45d5aa0ff20a8b96b23d01e050e88
# Apalache proves that an inductive invariant of a TLA+ model holds in every state, for `tla`.
# It needs Java 21 or newer; TLC needs 11.
APALACHE_VERSION=0.62.4
APALACHE_URL=https://github.com/apalache-mc/apalache/releases/download/v${APALACHE_VERSION}/apalache-${APALACHE_VERSION}.tgz
APALACHE_SHA256=b781b53bba32fac14ac2e02b0332e1dc2edc64cb7b850c0608d8142cc7aa2ef4
# Verus checks the proofs written in Rust code, for the opt-in `verus` gate: the latest release,
# not the rolling build. It runs on one Rust toolchain of its own, which `rustup install` adds.
VERUS_VERSION=0.2026.10.04.426d8b0
VERUS_URL_x86_linux=https://github.com/verus-lang/verus/releases/download/release/${VERUS_VERSION}/verus-${VERUS_VERSION}-x86-linux.zip
VERUS_SHA256_x86_linux=624018662868563a7bec0dd07be5e4dd0c3d61124b4b55105765884bf2d4d1a0
VERUS_URL_x86_macos=https://github.com/verus-lang/verus/releases/download/release/${VERUS_VERSION}/verus-${VERUS_VERSION}-x86-macos.zip
VERUS_SHA256_x86_macos=9b00357ee298a3b052038abc85c0be3129ab2821762fe8be5eb8dcbe37349f9c
VERUS_URL_arm64_macos=https://github.com/verus-lang/verus/releases/download/release/${VERUS_VERSION}/verus-${VERUS_VERSION}-arm64-macos.zip
VERUS_SHA256_arm64_macos=83cafc50284caea07fa8762df04b00cc0af441f25cdf1631d6c30987c65af446
VERUS_URL_x86_win=https://github.com/verus-lang/verus/releases/download/release/${VERUS_VERSION}/verus-${VERUS_VERSION}-x86-win.zip
VERUS_SHA256_x86_win=b36968a0f333036e7e1770bb73fdd407a35c8fd163124c1d309972574150da61

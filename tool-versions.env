# Pinned versions of every tool a gate depends on.
# Read by `chock init --global` (installs these) and `chock doctor` (fails when the machine drifts).
# A newer chock's `chock init` sets every key chock pins, and keeps each key it does not.
# KEY_VERSION pins a crate; KEY_BIN overrides the executable name when it differs from the crate;
# KEY_SETUP runs after installing, for a tool that fetches the rest of itself; KEY_OS lists the
# systems a tool runs on (linux, macos, windows), where that is not all of them.
# KEY_URL and KEY_SHA256 pin a file to download instead of a crate: init fetches it, keeps it only
# when its SHA-256 matches, and unpacks an archive. KEY_URL_linux (or _macos, _x86_64, _arm64…)
# pins one file for each system. A value may use ${KEY} of an earlier line.
# An unpinned gate tool means two machines score the same tree differently and neither is wrong.

# First, so every tool after it installs from its own prebuilt release instead of compiling.
CARGO_BINSTALL_VERSION=1.26.1
CARGO_NEXTEST_VERSION=0.9.150
CARGO_LLVM_COV_VERSION=0.9.1
CARGO_CRAP_VERSION=0.9.0
# cargo-deny from the outpostHQ fork: 0.20.2 overflows its stack on a dependency cycle in
# `check bans` (EmbarkStudios/cargo-deny#910). The fork fixes it; init compiles it from this commit.
CARGO_DENY_VERSION=0.20.2
CARGO_DENY_GIT=https://github.com/outpostHQ/cargo-deny
CARGO_DENY_REV=12c3c7b5916acd72a92db2b1f9d6806340a132e7
CARGO_SORT_VERSION=2.1.4
CARGO_ACL_VERSION=0.9.0
# cackle refuses to compile anywhere but Linux; elsewhere init skips it and doctor says why.
CARGO_ACL_OS=linux
CARGO_MACHETE_VERSION=0.9.2
# udeps needs a nightly toolchain and a full build, so it is opt-in. It is not a superset of
# machete and machete is not a superset of it, which is why both are pinned.
CARGO_UDEPS_VERSION=0.1.61
CARGO_BSIZE_VERSION=0.0.2
TYPOS_CLI_VERSION=1.51.1
TYPOS_CLI_BIN=typos
# Outpost's fork, on no registry: `chock init --global` builds the newest commit of its `main`, and
# doctor compares the installed commit with that one.
CARGO_MUTEST_VERSION=0.0.0
# mutest-driver links librustc_driver from one exact compiler build, so the binary only runs with
# the nightly it was built against. Installed with rustc-dev and llvm-tools.
MUTEST_NIGHTLY=nightly-2026-10-17
# Outpost's CLI, for the gates that ask it something chock does not answer for itself. Not on
# crates.io either, and every gate that uses it is opt-in and says so when it is absent.
OUTPOST_VERSION=0.0.0

{
  "$schema": "https://raw.githubusercontent.com/outpostHQ/chock/main/schema/config-v1.json",
  "version": 1,
  "enabled": [
    "acl",
    "admits",
    "assertions",
    "bigfiles",
    "binsize",
    "boundaries",
    "bsize",
    "calls",
    "citations",
    "claims",
    "codeslop",
    "commands",
    "commands-build",
    "commits",
    "complexity",
    "coverage",
    "crap",
    "dead",
    "deps",
    "doc",
    "dupdeps",
    "duplicates",
    "duplication",
    "echoes",
    "features",
    "fmt",
    "hazards",
    "history",
    "hygiene",
    "idempotent",
    "lean",
    "laws",
    "lenses",
    "lines",
    "links",
    "lint",
    "manifest",
    "measures",
    "miri",
    "modcheck",
    "msrv",
    "mutest",
    "nesting",
    "owners",
    "padding",
    "phrases",
    "pinned",
    "placement",
    "profile",
    "proof",
    "scan",
    "seams",
    "slop",
    "sort",
    "source",
    "splits",
    "supply",
    "test",
    "testlint",
    "tla",
    "toolchain",
    "typos",
    "unread",
    "unreferenced",
    "unsafety",
    "unused",
    "unused-deep",
    "verus",
    "wiring",
    "workflows",
    "wrappers"
  ],
  "vcs": "git",
  "lint_floor": true,
  "local_only": [
    "boundaries",
    "duplicates",
    "hazards",
    "history",
    "lenses",
    "measures",
    "padding",
    "scan",
    "unread",
    "unreferenced",
    "wrappers"
  ],
  "commands": [
    { "name": "package-list", "run": ["cargo", "package", "--locked", "--allow-dirty", "--list"] },
    { "name": "package-builds", "run": ["cargo", "package", "--locked", "--allow-dirty"], "builds": true }
  ],
  "forbidden": [
    { "text": "utilize", "why": "Write \"use\".", "word": true },
    { "text": "utilise", "why": "Write \"use\".", "word": true },
    { "text": "leverage", "why": "Write \"use\".", "word": true },
    { "text": "in order to", "why": "Write \"to\".", "word": true },
    { "text": "prior to", "why": "Write \"before\".", "word": true },
    { "text": "approximately", "why": "Write \"about\".", "word": true },
    { "text": "commence", "why": "Write \"start\".", "word": true },
    { "text": "basically", "why": "Filler. Delete it.", "word": true },
    { "text": "simply", "why": "Filler. Delete it.", "word": true },
    { "text": "obviously", "why": "Filler. Delete it.", "word": true },
    { "text": "actually", "why": "Filler. Delete it.", "word": true },
    { "text": "really", "why": "Filler. Delete it.", "word": true },
    { "text": "essentially", "why": "Filler. Delete it.", "word": true },
    { "text": "robust", "why": "A reader cannot check it. Name the property.", "word": true },
    { "text": "seamless", "why": "A reader cannot check it. Name the property.", "word": true },
    { "text": "comprehensive", "why": "A reader cannot check it. Name the property.", "word": true },
    { "text": "crucial", "why": "A reader cannot check it. Name the property.", "word": true },
    { "text": "delve", "why": "Write \"read\" or \"look at\".", "word": true }
  ],
  "seams": [
    { "path": "syn", "only": ["src/gates/**", "src/tokens.rs"], "why": "Only the gates and the token reader parse Rust source." },
    { "path": "proc_macro2", "only": ["src/gates/**", "src/tokens.rs"], "why": "Only the gates and the token reader parse Rust source." },
    { "path": "std::process::Command", "only": ["src/exec/**", "src/setup/init.rs", "src/setup/init/install.rs", "src/oracle/side.rs"], "why": "A gate starts each process in exec, which paces it and stops it at its limit. Only init's installs, which show their progress, and the oracle's sandbox start their own." }
  ],
  "owners": [
    { "call": "std::env::var", "why": "Read each variable in one place, and pass the value on." },
    { "call": "std::env::var_os", "why": "Read each variable in one place, and pass the value on." }
  ],
  "calls": [
    { "call": "std::fs::rename", "after": "write", "why": "A rename puts a staged file or directory in place, so a reader never sees it half written. Write the staged item first." }
  ],
  "stage": {
    "acl": "ci",
    "binsize": "ci",
    "bsize": "ci",
    "miri": "ci",
    "mutest": "ci",
    "proof": "ci"
  }
}
